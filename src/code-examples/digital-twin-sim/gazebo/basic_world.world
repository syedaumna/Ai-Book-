<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Optional: Add a simple light source if 'sun' is not enough or for specific effects -->
