<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="minimal_world">
    <!-- A simple sun light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- A simple ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- A minimal box model -->
    <model name="my_box">
      <pose>0 0 0.5 0 0 0</pose> <!-- x y z roll pitch yaw -->
      <link name="box_link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.166667</ixx> <ixy>0</ixy> <ixz>0</ixz>
            <iyy>0.166667</iyy> <iyz>0</iyz> <izz>0.166667</izz>
          </inertia>
        </inertial>
        <collision name="box_collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
